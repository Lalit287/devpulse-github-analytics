# Optional shell environment; no credentials are needed. Source with: set -a; source .env; set +a
DEVPULSE_MAX_DISK_MB=500
DEVPULSE_TIMEOUT=60
DEVPULSE_SAMPLE_SIZE=10000
# If Java 17 is not automatically detected, set its installation directory here.
# JAVA_HOME=/opt/homebrew/opt/openjdk@17/libexec/openjdk.jdk/Contents/Home
SPARK_LOCAL_IP=127.0.0.1
# Week 2: project-specific Hadoop installation (auto-detected if omitted)
# DEVPULSE_HADOOP_HOME=/opt/hadoop
# Week 2 collection CLI defaults: 4096 MiB raw and 4096 MiB HDFS/bronze.
